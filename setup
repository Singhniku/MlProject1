#!/usr/bin/env bash
# Sets up and launches the MS Fall 2027 Application Dashboard.
set -euo pipefail
cd "$(dirname "$0")"

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required but not found. Install Python 3 and re-run ./setup." >&2
  exit 1
fi

# Resume Modifier's AI rewrite needs a Gemini API key. Store it in config/.env
# (gitignored, chmod 600) — never in the browser or the bundled artifact.
mkdir -p config
if [ -f config/.env ] && grep -q '^GEMINI_API_KEY=.\+' config/.env 2>/dev/null; then
  echo "config/.env already has a GEMINI_API_KEY — skipping."
elif [ -n "${GEMINI_API_KEY:-}" ]; then
  echo "Using GEMINI_API_KEY from your shell environment."
else
  echo ""
  echo "The Resume Modifier's AI rewrite calls the Gemini API with your own key."
  echo "Get one at https://aistudio.google.com/apikey (skip to use ATS scoring only)."
  read -rp "Paste your Gemini API key (or press Enter to skip): " key
  if [ -n "$key" ]; then
    printf 'GEMINI_API_KEY=%s\n' "$key" >> config/.env
    chmod 600 config/.env
    echo "Saved to config/.env (gitignored — never committed, never sent to the browser)."
  else
    echo "Skipped. ATS scoring still works fully; add a key to config/.env later to enable AI rewrite."
  fi
fi

echo ""
echo "Building grad-dashboard.html from src/ …"
python3 build.py

# Free the port if a previous instance is still running.
if command -v lsof >/dev/null 2>&1; then
  PIDS=$(lsof -ti tcp:8500 2>/dev/null || true)
  [ -n "$PIDS" ] && kill $PIDS 2>/dev/null || true
fi

echo "Starting the dashboard at http://127.0.0.1:8500 …"
python3 server.py &
SERVER_PID=$!
sleep 1

if command -v open >/dev/null 2>&1; then
  open "http://127.0.0.1:8500"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "http://127.0.0.1:8500"
else
  echo "Open http://127.0.0.1:8500 in your browser."
fi

echo ""
echo "Dashboard running (pid $SERVER_PID). Press Ctrl+C to stop."
trap 'kill $SERVER_PID 2>/dev/null' INT TERM
wait $SERVER_PID
